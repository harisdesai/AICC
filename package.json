{
  "name": "aicc-monorepo",
  "private": true,
  "scripts": {
    "server": "node Aicc_backend/server.js",
    "client": "npm run dev --prefix Aicc_frontend",
    "dev": "node Aicc_backend/server.js",
    "db:apply": "node scripts/apply-schema.js",
    "build:client": "cd Aicc_frontend && npm install && node node_modules/vite/bin/vite.js build",
    "build": "npm run build:client",
    "start": "node Aicc_backend/server.js",
    "start:prod": "node Aicc_backend/server.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "chromadb": "^1.10.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "groq-sdk": "^0.5.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.5",
    "uuid": "^9.0.1",
    "ws": "^8.16.0",
    "zod": "^3.23.8",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "vite": "^5.2.6"
  }
