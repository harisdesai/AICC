DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aicc
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000

# Production: set NODE_ENV=production and run npm run build then npm run start:prod
# NODE_ENV=production
# CORS_ORIGIN=https://your-domain.com
# TRUST_PROXY=1

# AI & speech — restart server after changes
# Groq: interview questions + evaluation (https://console.groq.com)
GROQ_API_KEY=
# Optional if default model fails: GROQ_MODEL=openai/gpt-oss-120b (or openai/gpt-oss-20b, qwen/qwen3.8-27b)
# Deepgram: live transcription + end-of-speech (https://console.deepgram.com)
DEEPGRAM_API_KEY=
# Gemini: resume PDF parsing (https://aistudio.google.com)
GEMINI_API_KEY=
# Optional: GEMINI_MODEL=gemini-2.0-flash
# RAG (optional): run Chroma locally or set hosted URL
CHROMA_URL=http://localhost:8000
